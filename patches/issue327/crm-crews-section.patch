@@ -0,0 +1,21 @@
+import { describe, expect, it } from "vitest";
+import { crewPointsSource, crewRuleWrite } from "../club-crew-rule-source";
+
+describe("#327 CRM Crew: origem dos pontos", () => {
+  it("config ativa: 100 só de leitura com versão 2027-v1, mesmo que a regra diga 200", () => {
+    const s = crewPointsSource({ version: "2027-v1", crew_points: 100, effective_at: "2026-10-16T00:00:00Z" }, { points: 200 });
+    expect(s).toEqual({ kind: "config", points: 100, version: "2027-v1", effective_at: "2026-10-16T00:00:00Z", editable: false });
+  });
+  it("config ativa: gravar não envia points (motor ignora-os)", () => {
+    const s = crewPointsSource({ version: "2027-v1", crew_points: 100, effective_at: null }, { points: 200 });
+    expect(crewRuleWrite(s, { points: 999, min: 4, max: 6, active: true })).toEqual({ min_members: 4, max_members: 6, active: true });
+  });
+  it("sem config ativa: regra continua editável e gravada com points", () => {
+    const s = crewPointsSource(null, { points: 200 });
+    expect(s).toEqual({ kind: "rule", points: 200, editable: true });
+    expect(crewRuleWrite(s, { points: 150, min: 4, max: 6, active: true })).toEqual({ min_members: 4, max_members: 6, active: true, points: 150 });
+  });
+  it("sem config nem regra: valor por omissão 200 editável", () => {
+    expect(crewPointsSource(null, null).points).toBe(200);
+  });
+});
