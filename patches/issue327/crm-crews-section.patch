@@ -0,0 +1,19 @@
+// #327 — Origem dos pontos de "Crew completa" no CRM. Com config de pontos ATIVA, o motor paga config.crew_points
+// e ignora club_point_rules.points; o CRM mostra esse valor só de leitura com a versão de origem e não o grava.
+// Mínimo/máximo/ativa continuam em club_point_rules (o motor ainda os lê via club_crew_cfg).
+export type ActiveCfg = { version: string; crew_points: number; effective_at: string | null } | null;
+export type CrewRule = { points: number } | null;
+export type CrewPointsSource =
+  | { kind: "config"; points: number; version: string; effective_at: string | null; editable: false }
+  | { kind: "rule"; points: number; editable: true };
+
+export function crewPointsSource(cfg: ActiveCfg, rule: CrewRule, fallback = 200): CrewPointsSource {
+  if (cfg) return { kind: "config", points: Number(cfg.crew_points), version: cfg.version, effective_at: cfg.effective_at, editable: false };
+  return { kind: "rule", points: rule?.points ?? fallback, editable: true };
+}
+
+/** Linha a gravar em club_point_rules: sem `points` quando a config ativa manda (nunca escrever um valor que o motor ignora). */
+export function crewRuleWrite(src: CrewPointsSource, v: { points: number; min: number; max: number; active: boolean }) {
+  const base = { min_members: v.min, max_members: v.max, active: v.active };
+  return src.editable ? { ...base, points: v.points } : base;
+}
